Package: sysPrep
Title: Preprocessing Methods for NSSP ESSENCE Syndromic Surveillance Data
Version: 0.0.0.9000
Authors@R:
    person(
      given   = "Andrew",
      family  = "Farrey",
      email   = "afarrey11@gmail.com",
      role    = c("aut", "cre"),
      comment = c(ORCID = "0000-0003-4279-0998")
